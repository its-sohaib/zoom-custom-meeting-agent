# Full Zoom invite URL, e.g. https://zoom.us/j/1234567890?pwd=...
ZOOM_MEETING_URL=https://zoom.us/j/95778555132?pwd=DvapCDWGbmtozMxQOFEgjjGNbhxKaR.1

# Display name shown to other participants when joining as guest
GUEST_NAME=Malik

# Optional: if the meeting requires a passcode and it is not in the URL
# ZOOM_PASSCODE=

# --- Real microphone / camera (voice to participants) ---
# Set to 1, true, or yes to use your real mic instead of Chromium fake devices.
# Use headed mode (default). On macOS, allow microphone for Chromium / your terminal if prompted.
# After join: use Join with computer audio and Unmute (script tries this best-effort).
# USE_REAL_MEDIA=1

# --- OpenAI Realtime audio bridge (see npm run realtime:bridge) ---
# Required for src/realtime-audio-bridge.mjs
# OPENAI_API_KEY=

# Optional overrides:
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# REALTIME_PROMPT=Say hello in one short sentence.
# REALTIME_INSTRUCTIONS=Speak clearly and briefly.
# REALTIME_PCM_RATE=24000
